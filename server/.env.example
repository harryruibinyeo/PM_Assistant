# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env - it's already gitignored, keep it that way.
#
# If your working copy lives under a cloud-synced folder (OneDrive, Dropbox,
# iCloud Drive), consider moving it out. .gitignore stops git from
# committing .env; it does nothing to stop the sync client from uploading it.

# ---------------------------------------------------------------------------
# Telegram - two SEPARATE bots (see docs/ARCHITECTURE.md)
# ---------------------------------------------------------------------------

# The employee-facing "chase" bot. Get one from @BotFather on Telegram
# (send /newbot). Used by telegram_send_message/telegram_get_updates - the
# team's check-in pings and replies flow through this token.
TELEGRAM_BOT_TOKEN=

# S.A.M.'s own bot - the manager-facing identity, entirely separate from
# the chase bot above. Used only by notify_manager(). Previously undocumented
# here (a real gap: a fresh deploy without this silently loses every
# escalation and status notification to the manager - notify_manager just
# returns an error, with nothing else surfacing that failure).
TASK_MANAGER_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Defaults to server/pm_chaser.db if unset. In Docker/Kubernetes this is set
# to a path on a mounted volume so data survives a container restart
# (see server/Dockerfile, k8s/pvc.yaml).
PM_CHASER_DB_PATH=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Defaults to 0.0.0.0:8000 if unset. Binding 0.0.0.0 exposes the MCP
# endpoint and /internal/peek to anyone who can reach this host on the
# network unless PM_CHASER_MCP_TOKEN below is also set. Prefer 127.0.0.1
# for local development unless you specifically need another host on your
# LAN to reach this server - the real deployment does this at the Docker
# port-publish layer instead (docker-compose.yml binds 127.0.0.1 on the
# host side while the container itself still listens on 0.0.0.0, which
# Docker's port forwarding requires).
PM_CHASER_HOST=
PM_CHASER_PORT=

# Phase 4 (finding #4): optional shared-secret bearer token gating the MCP
# endpoint and /internal/peek (never /healthz - see pmchaser/mcp/auth.py).
# Unset by default - the real deployment doesn't have this configured yet,
# so leaving it unset here preserves today's actual behavior. To turn it
# on: set a long random value here, then add the matching
# `headers: Authorization: "Bearer ${PM_CHASER_MCP_TOKEN}"` under
# mcp_servers.pm-chaser in BOTH hermes-config/*/config.yaml files (Hermes
# resolves ${...} from ~/.hermes/.env - never write the literal token into
# a config.yaml). See BRANCH_TESTING.md before doing this against the live
# bot - it's a hermes-config change, which goes live the moment it's
# checked out.
PM_CHASER_MCP_TOKEN=

# IANA timezone name. Deadlines typed without an explicit UTC offset
# ("Friday 5pm") are interpreted in this timezone - see models.py's module
# docstring. Defaults to Asia/Singapore if unset.
PM_CHASER_TZ=

# ---------------------------------------------------------------------------
# Local LLM (LM Studio) - consumed by the Hermes Agent profiles, not by
# this server directly, but documented here since it's part of the same
# deployment and previously lived only in hermes-config/*/config.yaml with
# no single place recording it.
# ---------------------------------------------------------------------------
LM_STUDIO_BASE_URL=http://192.168.1.8:1234/v1
