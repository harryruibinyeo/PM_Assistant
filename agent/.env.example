# Copy this file to .env and fill in real values.
#
# Token for the manager's own dedicated Telegram bot (separate from
# server/.env's TELEGRAM_BOT_TOKEN, which is the employee-facing bot).
# Get one from @BotFather on Telegram (send /newbot).
PM_BOT_TELEGRAM_TOKEN=

# The manager's Telegram chat_id. Telegram private-chat chat.id is the
# user's own numeric ID, not bot-scoped, so this is the same value already
# stored on the manager's Person record from linking the employee bot —
# confirm it by messaging the new bot once and checking getUpdates.
MANAGER_CHAT_ID=
